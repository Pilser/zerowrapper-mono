# Zerowrapper environment — copy to your runtime env file (e.g.
# deployment/zerowrapper-mono/mono.env) and fill in secrets. Never commit
# the filled-in file.

# ── Engine backend: daemon (zeroclaw socket, default) or embedded ──
# Daemon path is untouched; set this to route chat through the in-process
# zerostack engine instead.
ZEROWRAPPER_ENGINE=embedded

# ── Provider / model (embedded engine) ──────────────────────────────
# Resolution order is CLI flag > THESE env vars > zerostack config file >
# built-in fallback. Nothing is hardcoded: the deepseek-v4-pro default you
# see in the code is only the LAST resort when none of the above is set.
#
# DeepSeek DIRECT (api.deepseek.com, OpenAI-compatible) — not OpenRouter.
# The name must match [custom_providers.deepseek] in the zerostack config
# file below.
ZS_PROVIDER=deepseek
# Direct-API model id. If the API answers "model not found", swap in the
# exact id from DeepSeek's docs (reasoning model if you want thinking).
ZS_MODEL=deepseek-v4-flash

# API key. Read via the custom provider's `api_key_env`, NOT via a CLI flag
# (flags leak through ps/htop). No ZS_ binding exists for keys by design.
DEEPSEEK_API_KEY=sk-...

# ── Zerostack config file (declares the custom endpoint + tuning) ────
# Path lookup: $ZS_CONFIG_DIR, else ~/.config/zerostack/, else data dir.
# ZS_CONFIG_DIR=/home/vox/.config/zerostack
# ZS_DATA_DIR=/home/vox/.local/share/zerostack
#
# --- config.toml (same dir) ------------------------------------------
# provider = "deepseek"          # optional: env above already sets it
# model = "deepseek-v4-flash"    # optional: env above already sets it
#
# # DeepSeek direct endpoint (OpenAI-compatible: chat completions +
# # streaming + tool calls over Bearer auth).
# [custom_providers.deepseek]
# provider_type = "openai"       # "openai"|"custom" = OpenAI-style client
# base_url = "https://api.deepseek.com"
# api_key_env = "DEEPSEEK_API_KEY"
#
# # ── Thinking / sampling ──────────────────────────────────────────
# # DeepSeek exposes NO thinking-effort knob (unlike Claude): reasoning
# # depth is chosen by the model id (reasoning vs chat variant). What you
# # CAN tune:
# # Reasoning text always streams as Thinking events regardless of this;
# # `true` ALSO folds it into the final response text.
# show_reasoning = false
# # Sampling temperature 0.0–2.0 (lower = more deterministic reasoning).
# temperature = 0.7
# # Override if the model is missing from the token catalog (else auto).
# # context_window = 128000
